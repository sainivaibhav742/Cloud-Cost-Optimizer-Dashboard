# Database Configuration
DATABASE_URL=sqlite:///./cloud_cost_db.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/cloud_cost_db

# JWT Authentication
SECRET_KEY=your-secret-key-here-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS Configuration (optional - for real cloud cost data)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# GCP Configuration (optional)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
GCP_PROJECT_ID=your-gcp-project-id

# Azure Configuration (optional)
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id
AZURE_SUBSCRIPTION_ID=your-subscription-id

# OpenAI API (optional - for AI-powered recommendations)
OPENAI_API_KEY=sk-your-openai-api-key

# Email Alerts (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=cost-optimizer@yourdomain.com
ALERT_EMAIL=alerts@yourdomain.com

# Slack Alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#cost-alerts

# Redis (optional - for Celery background tasks)
REDIS_URL=redis://localhost:6379/0

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_DEMO_MODE=true
